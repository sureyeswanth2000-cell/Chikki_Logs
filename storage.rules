rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Each user can read and overwrite only their own profile photo.
    // Write is further restricted to images under 2 MB so the server
    // enforces the same limit the client already checks.
    match /profile-photos/{userId}/photo {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
